---
import CRTWarp from '../components/CRTWarp.jsx';
import '../styles/global.css';

const projects = [
  {
    number: '01',
    title: 'Mapperatorinator',
    description: 'An in-progress generative AI project for creating osu! beatmaps. I’m currently implementing additional features.',
    kind: 'Generative AI / osu!',
    href: 'https://github.com/christveuster/Mapperatorinator',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111713" />
    <meta name="description" content="Christian Michael, known as Sountren: Computer Science student, web developer, and generative AI enthusiast." />
    <title>Christian Michael (Sountren) — Computer Science Student</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <main id="main">
      <header class="hero" id="top">
        <div class="hero__media" aria-hidden="true">
          <div class="hero__static-fallback"></div>
          <CRTWarp client:only="react" />
        </div>
        <div class="hero__inner wrap">
          <div class="masthead">
            <a class="wordmark" href="#top" aria-label="Christian Michael, home">CM /</a>
            <p class="masthead__meta">Christian Michael / Portfolio</p>
            <nav class="nav" aria-label="Main navigation">
              <a href="#work">Work</a>
              <a href="#about">About</a>
              <a href="/links">Links</a>
            </nav>
          </div>

          <div class="hero__copy">
            <p class="eyebrow">Computer Science student / class of ’27</p>
            <h1>Hello, I’m<br /><span>Sountren.</span></h1>
            <p class="hero__intro">I’m Christian Michael, a Computer Science student at Universitas Indraprasta PGRI. I work with web development, Python, and C++.</p>
            <div class="hero__actions">
              <a class="text-link text-link--primary" href="#work">Explore my project <span aria-hidden="true">↓</span></a>
              <a class="text-link" href="/links">Find me online <span aria-hidden="true">↗</span></a>
            </div>
          </div>

          <div class="hero__foot" aria-hidden="true">
            <p>Christian Michael / Sountren</p>
            <p>Chess / Code / Community</p>
          </div>
        </div>
      </header>

      <section class="section wrap" id="work" aria-labelledby="work-title">
        <p class="section-label"><strong>01</strong><span>Project</span><span>Generative AI / rhythm games</span></p>
        <h2 class="section-title" id="work-title">A project in<br />progress.</h2>
        <div class="project-list">
          {projects.map((project) => (
            <a class="project" href={project.href} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.title} on GitHub`}>
              <span class="project__number">{project.number}</span>
              <div>
                <h3 class="project__title">{project.title}</h3>
                <p class="project__description">{project.description}</p>
              </div>
              <span class="project__kind">{project.kind} ↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section section--about" id="about" aria-labelledby="about-title">
        <div class="wrap">
          <p class="section-label"><strong>02</strong><span>About</span><span>A little context</span></p>
          <div class="about-grid">
            <h2 class="section-title" id="about-title">Computer Science<br />student. Curious<br />builder.</h2>
            <div class="about-copy">
              <p>I’m studying Computer Science at Universitas Indraprasta PGRI as part of the class of ’27. My programming interests include web development, Python, and C++.</p>
              <p>Outside code, I enjoy chess, learning languages, and attending IT events. I’m also exploring generative AI through Mapperatorinator, an in-progress osu! beatmap project.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section wrap" aria-labelledby="experience-title">
        <p class="section-label"><strong>03</strong><span>Education</span><span>Current studies</span></p>
        <h2 class="section-title" id="experience-title">Learning the<br />foundations.</h2>
        <div class="experience-list">
          <article class="experience">
            <span class="experience__date">Class of ’27</span>
            <div>
              <h3>Computer Science</h3>
              <p>Universitas Indraprasta PGRI</p>
            </div>
          </article>
          <article class="experience">
            <span class="experience__date">Class of ’23</span>
            <div>
              <h3>Science Track</h3>
              <p>SMAN 48, East Jakarta</p>
            </div>
          </article>
        </div>
      </section>

      <section class="section section--contact" id="contact" aria-labelledby="contact-title">
        <div class="wrap">
            <p class="section-label"><strong>04</strong><span>Contact</span><span>Find me around the web</span></p>
          <div class="contact-grid">
              <h2 class="section-title" id="contact-title">Say hello<br />or follow along.</h2>
            <div>
              <p class="contact__label">Email</p>
                <a class="contact-email" href="mailto:damianveuster27@gmail.com">damianveuster27@gmail.com ↗</a>
                <p class="contact__label contact__label--links">More links</p>
                <a class="contact-email" href="/links">Social profiles ↗</a>
            </div>
          </div>
          <footer class="site-footer">
            <p>Christian Michael / Sountren</p>
            <p>Computer Science / Class of ’27</p>
          </footer>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  .hero__static-fallback {
    position: absolute;
    inset: 0;
    background-color: #111713;
    background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 3px, rgba(201, 229, 154, 0.035) 4px);
  }
</style>